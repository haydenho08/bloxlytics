# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# Ingestion API. 127.0.0.1 = only this machine. Use 0.0.0.0 inside a container.
API_HOST=127.0.0.1
API_PORT=8080

# Postgres (docker-compose maps container 5432 -> host 5433)
DATABASE_URL=postgres://gamepulse:gamepulse@localhost:5433/gamepulse
TEST_DATABASE_URL=postgres://gamepulse:gamepulse@localhost:5433/gamepulse_test

# Redis (docker-compose maps container 6379 -> host 6380). /0 = dev, /1 = tests
REDIS_URL=redis://localhost:6380/0
TEST_REDIS_URL=redis://localhost:6380/1

# Redis Stream the API writes to and the worker reads from
EVENTS_STREAM=gp:events

# Backpressure: reject new batches with 503 once this many entries are waiting
STREAM_MAX_PENDING=1000000

# Per-game token bucket: sustained events/sec and burst size
RATE_LIMIT_EVENTS_PER_SEC=500
RATE_LIMIT_BURST=2000

# Worker (Stage 2). Everything below has a sensible default.
DEAD_LETTER_STREAM=gp:events:dlq
WORKER_GROUP=gp-workers
# WORKER_CONSUMER defaults to <hostname>-<pid>; must be unique per running worker
WORKER_BATCH_SIZE=500
WORKER_BLOCK_MS=2000
# Entries unacknowledged this long are taken over from a worker presumed dead
WORKER_CLAIM_IDLE_MS=60000
# Entries delivered more times than this go to the dead letter stream
WORKER_MAX_DELIVERIES=5
# Periodic rollups (players online, retention)
ROLLUP_REFRESH_MS=15000
ONLINE_WINDOW_MINUTES=60
SERVER_STALE_AFTER_MS=300000
